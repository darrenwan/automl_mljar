{
  "name": "Ruff Code Linting and Fixing",
  "description": "保存 Python 文件时自动运行 Ruff 格式化",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "**/*.py"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "CALL conda.bat activate && conda activate py312_mljar && ruff format ."
  }
}
