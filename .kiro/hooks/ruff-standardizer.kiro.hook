{
  "name": "Ruff Code Linting and Fixing",
  "description": "保存 Python 文件时自动运行 Ruff 检查并修复可自动修复的错误",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "**/*.py"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "ruff check --fix ${file} && ruff format ${file}"
  }
}